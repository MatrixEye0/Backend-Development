<%- include('header') %>
        <div class="row mb-5">
            <div class="col-6">
                 <h4><%= title %></h4>
                      <table class="table">
                            <% items.forEach(items => {%>
                                 <tr>
                                  <td><%= items.name _%></td>
                                  <td><%= items.age _%></td>
                                   <td><%= items.city _%></td>
                                 </tr>
                               <% })%>
                      </table>
            </div>
                 <div class="col-6">
                     
                 </div>
        </div>

        <%- include('footer') %>